# ==========================================
# Unity Standard .gitignore
# Dành cho dự án game Unity 3D Survival Game
# ==========================================

# Thư mục cache và tạm của Unity (Bắt buộc phải bỏ qua, không được push lên Git)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# File tạm Visual Studio / VS Code / Rider
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# File hệ điều hành sinh ra
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db

# Báo cáo crash
sysinfo.txt
crash*

# File nén và cài đặt cục bộ
*.apk
*.aab
*.app

# Log and python temp scripts in project root
*.log
*.py
